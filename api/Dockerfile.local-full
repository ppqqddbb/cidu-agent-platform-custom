ARG CACHE_API_IMAGE=cidu-dify-api:custom-main-base-1.13.3

# base image
FROM python:3.12-slim-bookworm AS base

WORKDIR /app/api

ENV UV_VERSION=0.8.9
RUN pip install --no-cache-dir uv==${UV_VERSION}

FROM base AS packages

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
          git g++ \
          libmpfr-dev libmpc-dev

COPY api/pyproject.toml api/uv.lock ./
COPY api/providers ./providers
COPY dify-agent/pyproject.toml dify-agent/README.md /app/dify-agent/
COPY dify-agent/src /app/dify-agent/src
RUN uv sync --frozen --no-dev --no-editable

FROM ${CACHE_API_IMAGE} AS runtime_cache

FROM base AS production

ENV FLASK_APP=app.py
ENV EDITION=SELF_HOSTED
ENV DEPLOY_ENV=PRODUCTION
ENV CONSOLE_API_URL=http://127.0.0.1:5001
ENV CONSOLE_WEB_URL=http://127.0.0.1:3000
ENV SERVICE_API_URL=http://127.0.0.1:5001
ENV APP_WEB_URL=http://127.0.0.1:3000
ENV TZ=UTC
ENV LANG=en_US.UTF-8
ENV LC_ALL=en_US.UTF-8
ENV PYTHONIOENCODING=utf-8
ENV VIRTUAL_ENV=/app/api/.venv
ENV PATH="${VIRTUAL_ENV}/bin:${PATH}"
ENV TIKTOKEN_CACHE_DIR=/app/api/.tiktoken_cache
ENV NLTK_DATA=/usr/local/share/nltk_data

EXPOSE 5001
WORKDIR /app/api

ARG dify_uid=1001
ARG NODE_MAJOR=22
ARG NODE_PACKAGE_VERSION=22.21.0-1nodesource1
ARG NODESOURCE_KEY_FPR=6F71F525282841EEDAF851B42F59B5F99B1BE0B4
RUN groupadd -r -g ${dify_uid} dify && \
    useradd -r -m -d /home/dify -u ${dify_uid} -g ${dify_uid} -s /bin/bash dify && \
    chown -R dify:dify /app /home/dify

RUN \
    apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        gnupg \
    && mkdir -p /etc/apt/keyrings \
    && curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key -o /tmp/nodesource.gpg \
    && gpg --show-keys --with-colons /tmp/nodesource.gpg \
        | awk -F: '/^fpr:/ {print $10}' \
        | grep -Fx "${NODESOURCE_KEY_FPR}" \
    && gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg /tmp/nodesource.gpg \
    && rm -f /tmp/nodesource.gpg \
    && echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_${NODE_MAJOR}.x nodistro main" \
        > /etc/apt/sources.list.d/nodesource.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        nodejs=${NODE_PACKAGE_VERSION} \
        libgmp-dev libmpfr-dev libmpc-dev \
        expat libldap-2.5-0=2.5.13+dfsg-5 perl libsqlite3-0=3.40.1-2+deb12u2 zlib1g=1:1.2.13.dfsg-1 \
        fonts-noto-cjk \
        media-types \
        libmagic1 \
    && apt-get autoremove -y \
    && rm -rf /var/lib/apt/lists/*

COPY --from=packages --chown=dify:dify ${VIRTUAL_ENV} ${VIRTUAL_ENV}
COPY --from=runtime_cache /usr/local/share/nltk_data /usr/local/share/nltk_data
COPY --from=runtime_cache --chown=dify:dify /app/api/.tiktoken_cache /app/api/.tiktoken_cache
RUN chmod -R 755 /usr/local/share/nltk_data \
    && chown -R dify:dify ${TIKTOKEN_CACHE_DIR}

COPY --chown=dify:dify api /app/api/
COPY --chown=dify:dify --chmod=755 api/docker/entrypoint.sh /entrypoint.sh

ARG COMMIT_SHA
ENV COMMIT_SHA=${COMMIT_SHA}

USER dify
ENTRYPOINT ["/bin/bash", "/entrypoint.sh"]
